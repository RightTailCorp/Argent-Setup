<Window x:Class="Argent.SetupUi.Dialogs.OdbcRetryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argent Setup"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        MinWidth="420">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SetupTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Couldn’t open that ODBC source" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Try another DSN? If you say No, you stay here — Setup does not exit."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="No — turn off SQL" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="No_Click"/>
                <Button Content="Yes — pick another" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Yes_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
