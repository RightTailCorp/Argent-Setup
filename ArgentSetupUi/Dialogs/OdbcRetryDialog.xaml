<Window x:Class="Argent.SetupUi.Dialogs.OdbcRetryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argent Job Scheduler 10.0-2401-64W-A"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        MinWidth="420">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SetupTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="⚠" FontSize="28" Foreground="#D97706" VerticalAlignment="Top" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Failed to browse ODBC data source." FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Would you like to select another ODBC DSN?" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Yes" Width="80" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Yes_Click"/>
                    <Button Content="No" Width="80" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="No_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
