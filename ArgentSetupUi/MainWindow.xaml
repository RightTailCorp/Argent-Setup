<Window x:Class="Argent.SetupUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argent Setup"
        Width="1040" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B1F3A"
        FontFamily="Segoe UI">
    <Border Margin="16" CornerRadius="16" Background="#FBFCFF" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#083056">
                <DockPanel Margin="20,24,16,20">
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,16">
                        <TextBlock Text="A R G E N T" FontSize="20" FontWeight="Bold"
                                   Foreground="White" FontFamily="Georgia" Margin="0,0,0,14"/>
                        <TextBlock Text="ARGENT JOB SCHEDULER SETUP" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#8BA3BF" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ProductLine1}" FontSize="12" Foreground="#B8C9DB" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProductLine2}" FontSize="12" Foreground="#B8C9DB" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Border Height="1" Background="#2A4A6E" Margin="0,8,0,8"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#0F3A62" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                        <TextBlock FontSize="12" Foreground="#B8C9DB" TextWrapping="Wrap">
                            Questions --
                            <Hyperlink NavigateUri="https://help.argent.com" RequestNavigate="HelpLink_RequestNavigate" Foreground="#7DD3FC">
                                help.Argent.com
                            </Hyperlink>
                            or Support@Argent.com
                        </TextBlock>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="8,10" CornerRadius="10"
                                            Background="{Binding RowBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8"
                                                    Background="{Binding CircleBrush}">
                                                <TextBlock Text="{Binding IndexDisplay}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding IndexForeground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                       Foreground="{Binding TitleBrush}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1" Background="#FBFCFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="28,18,28,14" Background="White">
                    <Grid>
                        <TextBlock x:Name="StepPill" FontSize="13" FontWeight="SemiBold" Foreground="#0066CC" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="999" Padding="10,5">
                            <TextBlock x:Name="ProgressMeta" FontSize="12" Foreground="#64748B"/>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,16">
                    <ContentControl x:Name="PageHost"/>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Padding="28,14" Background="#FAFBFC">
                    <Grid>
                        <TextBlock x:Name="InlineValidation" Style="{StaticResource ValidationText}"
                                   VerticalAlignment="Center" Margin="0,0,200,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                            <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BackButton_Click"/>
                            <Button x:Name="NextButton" Content="Get started" Style="{StaticResource PrimaryButton}" Click="NextButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
